# Copy to .env and fill in. These are inlined at build time (Vite), so only
# put values here that are safe on the client — the Supabase anon key is, since
# it's already shipped in the web app.

# Supabase (same project as the web app) — exposed to the renderer.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# "App today". The web app currently runs on a frozen clock (2026-08-26) so its
# demo data doesn't age. Keep this matching it so the timer's day-plan lookups
# and the time_logs it writes line up with the web views. Set it empty ("") to
# use the real system date once the web app switches to a live clock.
VITE_APP_TODAY=2026-08-26

# Where the browser sign-in page lives — the web app's origin (it serves
# /desktop-auth). Used by the main process to open the system browser.
# Deployed app: https://vibe-pm-six.vercel.app  ·  local dev: http://localhost:3000
# (Whichever you use, its /desktop-auth must be in Supabase → Auth → Redirect URLs.)
MAIN_VITE_WEB_LOGIN_URL=https://vibe-pm-six.vercel.app
