# Copy to .env.local and fill in. Only NEXT_PUBLIC_* are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server / local scripts only — never commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_PROJECT_REF=your-project-ref

# Slack outbound (server-only) — used by app/api/slack/task-change.
# Bot User OAuth Token (xoxb-…) from a Slack app with chat:write; add the bot
# to each project channel. Leave unset to run the webhook in dry-run (logs only).
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Shared secret; set the same value as an "x-webhook-secret" header on the
# Supabase Database Webhook. Leave unset to skip verification (dev only).
SUPABASE_WEBHOOK_SECRET=some-long-random-string
